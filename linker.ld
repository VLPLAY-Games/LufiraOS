/* linker.ld - скрипт линковки для ядра LufiraOS */

ENTRY(_start)  /* Точка входа */

SECTIONS {
    /* Ядро будет загружено по адресу 0x1000 */
    . = 0x1000;
    
    /* Секция кода */
    .text : {
        *(.text)
    }
    
    /* Секция данных только для чтения */
    .rodata : {
        *(.rodata)
    }
    
    /* Секция данных */
    .data : {
        *(.data)
    }
    
    /* Секция BSS (неинициализированные данные) */
    .bss : {
        *(COMMON)
        *(.bss)
    }
    
    /* Конечный адрес ядра (для информации) */
    kernel_end = .;
}